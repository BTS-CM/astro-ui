--- 
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
}

const { title } = Astro.props;
import '@/styles/globals.css'
import ThemeProvider from '@/components/ThemeProvider.jsx'
import SidebarRoot from '@/components/SidebarRoot.jsx'
import CustomThemeStyle from '@/components/CustomThemeStyle.jsx'
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description">
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			// Apply the persisted custom theme before first paint (FOUC-free),
			// mirroring how the dark-mode class is applied. Re-applies across
			// Astro view transitions.
			//
			// IMPORTANT: the style element MUST be the LAST child of <head>. The
			// compiled Layout.css also defines default --accent-* variables on
			// :root, and a normal :root rule that appears LATER in the document
			// wins the cascade. If this element were inserted early (e.g. by this
			// inline script at parse time, before the Layout.css <link>), the
			// purple defaults from Layout.css would override the per-page accent
			// (turning instant trade purple instead of amber) on a full reload /
			// language switch. Appending last guarantees our theme always wins.
			(function () {
				function applyCustomTheme() {
					try {
						var raw = localStorage.getItem("btsThemeActiveCss");
						var css = raw ? JSON.parse(raw) : "";
						var el = document.getElementById("custom-theme-vars");
						if (!el) {
							el = document.createElement("style");
							el.id = "custom-theme-vars";
						}
						el.textContent = css || "";
						// Always keep it as the final node in <head> so it wins
						// the cascade over Layout.css's default --accent-* vars.
						document.head.appendChild(el);
					} catch (e) {}
				}
			// SYS-09 W3: per-page accent vars persisted by CustomThemeStyle
			// ({ themeId, accents: { slug: css } }). Applied here so colourful
			// pages don't flash default-purple accents on reload. Stale entries
			// (theme switched since) are skipped via themeId match. Regenerate
			// ROUTE_SLUG from src/pages/*/page props if routes change.
			var ROUTE_SLUG = {
					"account_lists": "AccountLists",
					"airdrop_calculate": "airdrop_calculate",
					"balances": "portfolio-balances",
					"barter": "barter",
					"blind_transfers": "blind_transfers",
					"blocked-users": "blocked-users",
					"blocks": "blocks",
					"borrow": "borrow",
					"call-orders": "call-orders",
					"change_password": "change_password",
					"committee": "committee",
					"committee_parameters": "committee_parameters",
					"create_account": "create_account",
					"create_invoice": "create_invoice",
					"create_pool": "create_pool",
					"create_smartcoin": "create_smartcoin",
					"create_ticket": "create_ticket",
					"create_uia": "uia",
					"create_vesting": "create_vesting",
					"create_worker": "create_worker",
					"custom_authorities": "custom_authorities",
					"custom_pool_overview": "custom_pool_overview",
					"custom_pool_tracker": "custom_pool_tracker",
					"deals": "deals",
					"dex": "dex",
					"edit_deal": "deals",
					"explorer": "explorer",
					"favourites": "favourites",
					"featured": "featured",
					"forum": "forum",
					"forum_thread": "forum",
					"governance": "governance",
					"htlc": "htlc",
					"index": "index",
					"instant_trade": "instant_trade",
					"invoice_inventory": "invoice_inventory",
					"issued_assets": "issuedAssets",
					"lend": "offereditor",
					"ltm": "ltm",
					"monthly_referrer": "monthly_referrer",
					"network_fees": "network_fees",
					"nodes": "nodes",
					"offer": "offer",
					"offers": "offers",
					"open-orders": "portfolio-open-orders",
					"order": "order",
					"page_themes": "page_themes",
					"pay_invoice": "pay_invoice",
					"pools": "pools",
					"proposals": "proposals",
					"publish_feed": "publish_feed",
					"recent-activity": "portfolio-recent-activity",
					"settlement": "settlement",
					"smartcoin": "smartcoin",
					"smartcoins": "smartcoins",
					"stake": "stake",
					"stored_invoices": "stored_invoices",
					"swap": "pool",
					"tfund_user": "tfund_user",
					"tfunds": "tfunds",
					"theme": "theme_customizer",
					"ticket_leaderboard": "ticket_leaderboard",
					"timed_transfer": "timed_transfer",
					"top-markets": "top-markets",
					"top-operations": "top-operations",
					"top-pools": "top-pools",
					"transfer": "transfer",
					"trollbox": "trollbox",
					"vesting": "vesting",
					"visuals": "configure_visuals",
					"vote": "vote",
					"withdraw_permissions": "withdraw_permissions",
					"witnesses": "witnesses"
			};
			function currentSlug() {
				try {
					var path = window.location.pathname || "/";
					if (path === "/" || path === "" || path === "/index.html") return "index";
					var m = path.match(/\/([^\/]+?)(?:\.html)?\/?$/);
					if (!m) return null;
					if (m[1] === "index") return "index";
					return ROUTE_SLUG[m[1]] || null;
				} catch (e) { return null; }
			}
			function applyPageAccent() {
				try {
					var slug = currentSlug();
					if (!slug) return;
					var activeRaw = localStorage.getItem("customTheme:activeThemeId");
					var activeId = activeRaw ? JSON.parse(activeRaw) : "default";
					var raw = localStorage.getItem("btsThemePageCss");
					if (!raw) return;
					var stored = JSON.parse(raw);
					if (!stored || stored.themeId !== activeId) return;
					var css = stored.accents && stored.accents[slug];
					if (!css) return;
					var el = document.getElementById("custom-theme-vars");
					if (!el) {
						el = document.createElement("style");
						el.id = "custom-theme-vars";
					}
					// Append AFTER the token css so page roles win; the final
					// appendChild in applyCustomTheme keeps cascade order.
					if (el.textContent) el.textContent += "\n" + css;
					else el.textContent = css;
				} catch (e) {}
			}
				applyCustomTheme();
				applyPageAccent();
				if (!window.__customThemeInit) {
					window.__customThemeInit = true;
					document.addEventListener("astro:after-swap", function () { applyCustomTheme(); applyPageAccent(); });
				}
			})();
		</script>
		<ClientRouter />
		<script is:inline>
			(function () {
				function isEditable(el) {
					if (!el) return false;
					var tag = (el.tagName || "").toLowerCase();
					if (tag === "input" || tag === "textarea" || tag === "select") return true;
					if (el.isContentEditable) return true;
					var p = el.parentElement;
					while (p) {
						if (p.isContentEditable) return true;
						p = p.parentElement;
					}
					return false;
				}
				function onBackspaceBack(e) {
					if (e.key !== "Backspace") return;
					if (e.ctrlKey || e.metaKey || e.altKey) return;
					if (isEditable(e.target)) return;
					if (window.history.length > 1) {
						e.preventDefault();
						window.history.back();
					}
				}
				document.addEventListener("keydown", onBackspaceBack);
			})();
		</script>
	</head>
	<body>
		<ThemeProvider client:only="react">
			<CustomThemeStyle client:only="react" />
			<SidebarRoot client:only="react">
				<slot />
			</SidebarRoot>
		</ThemeProvider>
	</body>
</html>
<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(45deg, rgb(var(--accent)), rgb(var(--accent-light)) 30%, rgb(var(--background)) 60%);
	}
	html {
		font-family: system-ui, sans-serif;
	}
	code {
		font-family: Menlo, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono,
			Bitstream Vera Sans Mono, Courier New, monospace;
	}
	body {
		min-height: 100%;
		background: hsl(var(--background));
		background-size: 224px;
	}
	main {
		margin: auto;
		padding: 1rem;
		width: 100%;
		max-width: calc(100% - 2rem);
		color: hsl(var(--foreground));
		font-size: 20px;
		line-height: 1.6;
		min-height: 100vh;
	}
</style>
